IDENTITY_MODE=mock
MEMORY_MODE=cache
TRACE_MODE=cache
DATABASE_PATH=.local/synapse.db
# Origins the Vite dev server runs on. Only needed if you change its port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Loopback the server-side demo runner posts to. Proofs are signed against
# ANS_PUBLIC_BASE_URL, not this, so the two differ by design.
LOCAL_BASE_URL=http://127.0.0.1:8000

# Live agents run on Virginia Tech ARC (OpenAI-compatible), one API key per
# role. Keys are minted at https://llm.arc.vt.edu; one key may be reused in all
# slots. Other options: gemini, huggingface, cerebras, groq, github, openrouter,
# openai.
BACKEND_PROVIDER=arc
FRONTEND_PROVIDER=arc
QA_PROVIDER=arc
ORCHESTRATOR_PROVIDER=none

# Virginia Tech ARC (OpenAI-compatible): use ARC_API_KEY_* per agent.
ARC_API_KEY_BACKEND=
ARC_API_KEY_FRONTEND=
ARC_API_KEY_QA=
ARC_API_KEY_ORCHESTRATOR=
ARC_MODEL=gpt-oss-120b
ARC_MODEL_BACKEND=gpt-oss-120b
ARC_MODEL_FRONTEND=gpt-oss-120b
ARC_MODEL_QA=gpt-oss-120b
ARC_MODEL_ORCHESTRATOR=
HUGGINGFACE_API_KEY=
# Optional. Defaults to the value below; set only to change the model.
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest
# Optional role-specific open model overrides:
HUGGINGFACE_MODEL_BACKEND=
HUGGINGFACE_MODEL_FRONTEND=
HUGGINGFACE_MODEL_QA=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

# Recommended Gemini setup: a separate key for each concurrent agent.
GEMINI_API_KEY_BACKEND=
GEMINI_API_KEY_FRONTEND=
GEMINI_API_KEY_QA=
# Optional single-key fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

CEREBRAS_API_KEY=
GROQ_API_KEY=
GITHUB_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Live agents run only in a local sandbox. Never commit .env.

# --- ANS (set IDENTITY_MODE=ans to turn on real verification; see docs/ANS.md) ---
# The CLI defaults to the OTE environment, so production must be set explicitly.
ANS_BASE_URL=https://api.godaddy.com
ANS_API_KEY=
ANS_API_SECRET=
# Zone the agents are registered under. Each agent gets its own host.
ANS_DOMAIN=
# Hosts allowed to serve a transparency-log badge. Checked before the badge URL
# taken from DNS is fetched, so a forged TXT record cannot redirect the verifier.
ANS_TRUSTED_TL_HOSTS=transparency.ans.godaddy.com,api.godaddy.com
# The authority DPoP htu claims are compared against. Must come from config,
# never from the request's Host header.
ANS_PUBLIC_BASE_URL=http://127.0.0.1:8000
ANS_DPOP_REQUIRED=true
# Optional PEM bundle of the ANS RA's identity-issuing CA. Without it the
# transparency-log badge is the only trust anchor and the server logs that.
ANS_IDENTITY_CA_BUNDLE=
ANS_BADGE_TTL_SECONDS=60
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_TRACE_TABLE=synapse_agent_traces
